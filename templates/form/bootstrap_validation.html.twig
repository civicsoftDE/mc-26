{# templates/form/bootstrap_validation.html.twig #}

{% use 'bootstrap_5_layout.html.twig' %}

{% block form_row %}
    {% set submitted = form.vars.submitted|default(false) %}
    {% set is_valid = submitted and form.vars.valid %}
    {% set is_invalid = submitted and not form.vars.valid %}

    {% set widget_attr = {} %}

    {% if is_valid or is_invalid %}
        {% set validation_class = is_valid ? 'is-valid' : 'is-invalid' %}

        {% set widgetAttr = {
            attr: attr|default({})|merge({
                class: ((attr.class|default('') ~ ' ' ~ validation_class)|trim)
            })
        } %}
    {% endif %}

    <div {% with {attr: row_attr|default({})|merge({class: ((row_attr.class|default('') ~ ' mb-3')|trim)})} %}{{ block('attributes') }}{% endwith %}>
        {{ form_label(form) }}

        {{ form_widget(form, widgetAttr) }}

        {% if is_valid and valid_feedback|default(null) is not null %}
            <div class="valid-feedback">
                {{ valid_feedback|trans }}
            </div>
        {% endif %}

        {% if is_invalid and invalid_feedback|default(null) is not null %}
            <div class="invalid-feedback">
                {{ invalid_feedback|trans }}
            </div>
        {% endif %}

        {{ form_errors(form) }}
    </div>
{% endblock %}
