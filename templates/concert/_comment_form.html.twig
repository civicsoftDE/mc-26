{#
hx-post: Die Route aus dem Controller
hx-target: Der CSS-Selector des Wrappers aus der show.html.twig
hx-swap: 'innerHTML' ersetzt den Inhalt des Wrappers mit der Server-Antwort
#}

{{ form_start(commentForm, {
    'attr': {
        'hx-post': path('concert_place_comment', {'id': current_live_event.id}),
        'hx-target': '#comments-list',
        'hx-swap': 'afterbegin',
        'hx-on::after-request': 'this.reset()',
        'class': 'comment-form'
    }
}) }}
<div class="row g-2 mb-2">
    <div class="col-12 col-lg-10">
        {{ form_widget(commentForm.content) }}
    </div>
    <div class="col-12 col-lg-2">
        <button type="submit" class="btn btn-primary w-100">
            Posten
        </button>
    </div>
</div>
{{ form_end(commentForm) }}
