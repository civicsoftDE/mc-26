{% extends 'base.html.twig' %}

{% block title %}Madness Crunch{% endblock %}

{% block body %}
    <div class="">
        <div class="container py-3">
            <h1 class="mb-3 visually-hidden">Aktuelles</h1>
            <h2 class="h4 bg-primary px-3 py-1 text-black">Kommendes Konzert</h2>

            {{ include('concert/_concert_list.html.twig', {'elements': concerts}) }}
            <div class="d-flex justify-content-start">
                <a href="{{ path('concert_index') }}" class="btn btn-sm btn-dark">Alle Konzerte ansehen</a>
            </div>
        </div>
        {% if not app.user %}
        <div class="container py-3">
            <div class="bg-dark pt-3 border border-white shadow border-3">
                <div class="text-center h2 mb-3">Keine Updates und Konzerte mehr verpassen?</div>
                <a href="{{ path('app_register') }}" class="btn btn-light w-100 btn-lg">Jetzt registrieren</a>
            </div>
        </div>
        {% endif %}
        <div class="container py-3">
            <h2 class="h4 bg-primary px-3 py-1 text-black">Aktuelles</h2>
            <div class="row row-cols-1 row-cols-lg-4 g-2 mb-2">
                {{ include('blog/_post_list.html.twig', {'posts': posts}) }}
            </div>
            <div class="d-flex justify-content-start">
                <a href="{{ path('blog_index') }}" class="btn btn-sm btn-dark">Alle News ansehen</a>
            </div>
        </div>
    </div>
{% endblock %}
