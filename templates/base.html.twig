<!DOCTYPE html>
<html lang="de" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, viewport-fit=cover, initial-scale=1, shrink-to-fit=no">
    <title>{% block title %}Welcome!{% endblock %}</title>

    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="favicon-16x16.png">
    <link rel="manifest" href="site.webmanifest">
    <link rel="mask-icon" href="safari-pinned-tab.svg" color="#333333">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#333333">

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>
<body class="polka">
<header>
    <nav class="navbar fixed-top navbar-expand-lg bg-secondary">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="{{ path('app_index') }}">
                <img src="{{ asset('img/mc-logo.svg') }}" class="img-fluid" style="max-height: 18px" alt="Madness Crunch Logo">
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto fw-bold">
                    <li class="nav-item">
                        <a class="nav-link {{ active_class(['blog_index', 'blog_show']) }}" href="{{ path('blog_index') }}">News</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ active_class(['concert_index', 'concert_show']) }}" href="{{ path('concert_index') }}">Konzerte</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ active_class(['band_index', 'band_show']) }}" href="{{ path('band_index') }}">Band</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ active_class(['picture_index', 'picture_show']) }}" href="{{ path('picture_index') }}">Fotos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ active_class(['music_index', 'music_show']) }}" href="{{ path('music_index') }}">Musik</a>
                    </li>
                </ul>
                <ul class="navbar-nav fw-bold">
                    <li class="nav-item">
                        {% if app.user %}
                            <a class="nav-link d-flex gap-2 {{ active_class(['profile_index', 'profile_edit']) }}" href="{{ path('profile_index') }}"><i class="bi bi-person"></i><span class="d-lg-none">Fanbase</span></a>
                        {% else %}
                            <a class="nav-link d-flex gap-2 {{ active_class(['app_login', 'app_register']) }}" href="{{ path('app_login') }}"><i class="bi bi-person"></i><span class="d-lg-none">Anmelden</span></a>
                        {% endif %}
                    </li>
                    <li class="nav-item">
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="nav-link d-flex gap-2" href="{{ path('admin') }}"><i class="bi bi-gear"></i><span class="d-lg-none">Administration</span></a>
                        {% endif %}
                    </li>
                    <li class="nav-item">
                        {% if app.user %}
                            <a class="nav-link d-flex gap-2" href="{{ logout_path() }}"><i class="bi bi-box-arrow-right"></i><span class="d-lg-none">Logout</span></a>
                        {% endif %}
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<main>
    <div class="container my-1">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>
    {% block body %}{% endblock %}
</main>
<footer class="bg-black py-3">
    <div class="container">
        <div class="row py-3">
            <div class="col">
                <div class="d-flex justify-content-start align-items-center gap-2">
                    <img src="{{ asset('img/mc-guy.svg') }}" class="img-fluid" style="max-height: 42px" alt="Madness Crunch Logo">
                    <div>
                        <div>&copy; 2021 - {{ "now"|date('Y') }}</div>
                        <div><img src="{{ asset('img/mc-logo.svg') }}" class="img-fluid" style="max-height: 12px" alt="Madness Crunch Logo"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row row-cols-1 row-cols-lg-3">
            <div class="col-12 col-lg-3">
                <h5>Social Media</h5>
                <ul class="list-inline">
                    <li class="list-inline-item">
                        <a class="nav-link"
                           href="https://www.instagram.com/madness_crunch/" target="_blank"><i class="bi bi-instagram" style="font-size: 1.5rem"></i></a>
                    </li>
                    <li class="list-inline-item">
                        <a class="nav-link"
                           href="https://www.youtube.com/@madnesscrunchofficial" target="_blank"><i class="bi bi-youtube"
                                                                 style="font-size: 1.5rem"></i></a>
                    </li>
                </ul>
            </div>
            <div class="col-12 col-lg-3">
                <h5>Fanbereich</h5>
                <ul class="list-unstyled">
                    <li class="nav-item">
                        <a class="nav-link mb-2" href="{{ path('profile_index') }}">Konzertfotos</a>
                    </li>
                    {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link mb-2" href="{{ path('app_logout') }}">Abmelden</a>
                    </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link mb-2" href="{{ path('app_login') }}">Anmelden</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link mb-2" href="{{ path('app_register') }}">Registrieren</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
            <div class="col-12 col-lg-3">
                <h5>Links</h5>
                <ul class="list-unstyled">
                    <li class="nav-item">
                        <a class="nav-link mb-2" href="{{ path('blog_index') }}">News</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link mb-2" href="{{ path('concert_index') }}">Konzerte</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link mb-2" href="{{ path('band_index') }}">Band</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link mb-2" href="{{ path('picture_index') }}">Fotos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link mb-2" href="{{ path('music_index') }}">Musik</a>
                    </li>
                </ul>
            </div>
            <div class="col-12 col-lg-3">
                <h5>Rechtliches</h5>
                {{ render(controller('App\\Controller\\AppController::legalIndex')) }}
            </div>
        </div>

    </div>
</footer>
</body>
</html>
