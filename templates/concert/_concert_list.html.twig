<div class="list-group list-group-flush mb-2">
    {% for concert in elements %}
        <div class="list-group-item bg-transparent concert-entry text-white py-3">
            <div class="row">
                <div class="col-12 align-self-center">
                    <h3 class="text-truncate"><a href="{{ path('concert_show',{'slug':concert.slug}) }}" class="stretched-link text-decoration-none">{{ concert.title }}</a></h3>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-lg-3">
                    <div class="fw-bold fs-4">{{ concert.startsAt|date('d.m.Y') }} - {{ concert.startsAt|date('H:i') }} Uhr</div>
                    <div>Doors: {{ concert.doorsOpenAt|date('H:i') }} Uhr</div>
                    {% if concert.isAgeRestricted %}
                        <div class="badge text-bg-danger">Ab {{ concert.ageLimit }} Jahren</div>
                    {% endif %}
                </div>
                <div class="col-12 col-lg-7 mb-2 mb-lg-0">
                    <div class="d-flex justify-content-start gap-3 align-items-center flex-wrap">
                        <div class="fw-bold fs-4 text-truncate">{{ concert.location.city }}, {{ concert.location.country }}</div>
                    </div>
                    <div>{{ concert.location.name }}</div>
                    {% if concert.SupportActs is not empty %}
                    <div>Mit: {{ concert.supportActs|join(', ') }}</div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% else %}
        <div class="list-group-item bg-transparent text-white py-3">
            Aktuell steht nichts an.
        </div>
    {% endfor %}
</div>
